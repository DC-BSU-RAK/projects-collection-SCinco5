<?xml version="1.0" encoding="utf-8"?>

<!--to make this file, first i just right clicked the res folder, hovered New, then pressed the Android Resource File -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    android:background="@android:color/transparent">

    <!--this is the popup box that pops up when you click the plate-->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FDF5E6">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

         <!-- this is the title of the popup box-->
            <TextView
                android:id="@+id/modalTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TITLE"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:textAlignment="center"
                android:textAllCaps="true" />

             <!-- this is Gordon's critique of the dish you chose           -->
            <TextView
                android:id="@+id/modalCritique"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="This is where the Gordon Ramsay critique goes."
                android:textSize="17sp"
                android:textColor="#4E342E"
                android:textAlignment="center"
                android:lineSpacingExtra="4dp" />


            <View
                android:layout_width="50dp"
                android:layout_height="2.5dp"
                android:layout_marginTop="20dp"
                android:background="#D2B48C" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>